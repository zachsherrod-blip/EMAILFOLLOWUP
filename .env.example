# Database
DATABASE_URL="postgresql://user:password@localhost:5432/followup_queue"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# TODO: Create a project at https://console.cloud.google.com
# Enable Gmail API and Google Calendar API
# Create OAuth 2.0 credentials with redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AI Provider (use one or both)
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Email Sending (Resend - https://resend.com)
# TODO: Create account at resend.com and get API key
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="followup@yourdomain.com"

# App
APP_BASE_URL="http://localhost:3000"

# Token encryption key (32 bytes hex = 64 chars)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="your-64-char-hex-encryption-key"
