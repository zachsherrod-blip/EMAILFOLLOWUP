generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  timezone      String    @default("America/New_York")
  digestEmail   String?
  digestHour    Int       @default(16)
  digestMinute  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  connectedAccounts ConnectedAccount[]
  contacts          Contact[]
  calendarEvents    CalendarEvent[]
  emailThreads      EmailThread[]
  emailMessages     EmailMessage[]
  followUpTasks     FollowUpTask[]
  digestRuns        DigestRun[]
  taskActions       TaskAction[]
  settings          UserSettings?
}

model ConnectedAccount {
  id                    String    @id @default(cuid())
  userId                String
  provider              String
  accessTokenEncrypted  String    @db.Text
  refreshTokenEncrypted String?   @db.Text
  expiresAt             DateTime?
  scope                 String?
  email                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Contact {
  id         String   @id @default(cuid())
  userId     String
  email      String
  name       String?
  company    String?
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
}

model CalendarEvent {
  id                   String   @id @default(cuid())
  userId               String
  googleEventId        String
  title                String
  description          String?  @db.Text
  startAt              DateTime
  endAt                DateTime
  organizerEmail       String?
  attendeesJson        Json     @default("[]")
  hasExternalAttendees Boolean  @default(false)
  isBusinessRelevant   Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  followUpTasks FollowUpTask[] @relation("EventTasks")

  @@unique([userId, googleEventId])
  @@index([userId, startAt])
}

model EmailThread {
  id               String    @id @default(cuid())
  userId           String
  gmailThreadId    String
  subject          String?
  participantsJson Json      @default("[]")
  lastMessageAt    DateTime?
  snippet          String?   @db.Text
  isRead           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      EmailMessage[]
  followUpTasks FollowUpTask[] @relation("ThreadTasks")

  @@unique([userId, gmailThreadId])
  @@index([userId])
}

model EmailMessage {
  id             String           @id @default(cuid())
  userId         String
  threadId       String
  gmailMessageId String
  sentAt         DateTime
  fromEmail      String
  toJson         Json             @default("[]")
  ccJson         Json             @default("[]")
  direction      MessageDirection
  bodySnippet    String?          @db.Text
  createdAt      DateTime         @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, gmailMessageId])
  @@index([userId, sentAt])
  @@index([threadId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model FollowUpTask {
  id              String        @id @default(cuid())
  userId          String
  sourceType      TaskSourceType
  sourceEventId   String?
  sourceThreadId  String?
  contactIdsJson  Json          @default("[]")
  title           String
  rationale       String        @db.Text
  priorityScore   Int           @default(50)
  priorityLabel   PriorityLabel @default(MEDIUM)
  shortPrompt     String        @db.Text
  status          TaskStatus    @default(OPEN)
  snoozedUntil    DateTime?
  autoCompletedAt DateTime?
  completedReason String?
  surfacedCount   Int           @default(0)
  lastSurfacedAt  DateTime?
  dedupeKey       String        @unique
  signalsJson     Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEvent  CalendarEvent? @relation("EventTasks", fields: [sourceEventId], references: [id])
  sourceThread EmailThread?   @relation("ThreadTasks", fields: [sourceThreadId], references: [id])
  actions      TaskAction[]

  @@index([userId, status])
  @@index([userId, priorityScore])
}

enum TaskSourceType {
  CALENDAR
  EMAIL
  BOTH
}

enum TaskStatus {
  OPEN
  COMPLETED
  DISMISSED
  SNOOZED
}

enum PriorityLabel {
  HIGH
  MEDIUM
  LOW
}

model DigestRun {
  id            String   @id @default(cuid())
  userId        String
  sentAt        DateTime @default(now())
  tasksIncluded Int      @default(0)
  subjectLine   String
  emailBody     String?  @db.Text
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
}

model TaskAction {
  id           String     @id @default(cuid())
  taskId       String
  userId       String
  action       ActionType
  metadataJson Json       @default("{}")
  createdAt    DateTime   @default(now())

  task FollowUpTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

enum ActionType {
  DISMISS
  SNOOZE
  AUTO_COMPLETE
  MANUAL_COMPLETE
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  internalDomainsJson  Json     @default("[]")
  minimumPriorityScore Int      @default(30)
  scanLookbackDays     Int      @default(14)
  businessHoursOnly    Boolean  @default(false)
  sendWeekdaysJson     Json     @default("[1,2,3,4,5]")
  autoCompleteOnReply  Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
